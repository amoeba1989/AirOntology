# 默认只监听ECS本机，由Nginx转发。临时直接访问可改为0.0.0.0。
BIND_ADDRESS=127.0.0.1
APP_PORT=8092
POSITION_ID=pos001
POSITION_NAME=一号阵地
POSITION_LON=116.4077
POSITION_LAT=39.9045
STALE_SECONDS=5
HIGH_THRESHOLD=100
MEDIUM_THRESHOLD=200
LOW_THRESHOLD=300
# 底图配置在构建时生效，修改后需重新build app。
VITE_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# 仅首次初始化生效；后续在页面配置中修改
HISTORY_LIMIT=300

# Fuseki学习环境资源配置；已有shared/.env无需追加也会使用这些默认值
FUSEKI_JVM_ARGS=-Xms64m -Xmx512m -XX:ActiveProcessorCount=2
FUSEKI_MEMORY_LIMIT=1g

# 可选：仅在后端配置；留空时展示规则结果，不调用大模型
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 演示默认10架，每2秒一批，减少小规格ECS写入压力
DEMO_TARGET_COUNT=10
DEMO_INTERVAL_SECONDS=2

# 原始设备观测主题（需先通过 API 登记设备）
MQTT_OBSERVATION_TOPIC=counteruav/observation/raw

# 四类对象模拟：台账登记和批量态势分开接收
MQTT_REGISTRY_TOPIC=counteruav/demo/devices
MQTT_TELEMETRY_TOPIC=counteruav/demo/telemetry
