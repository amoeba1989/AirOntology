@prefix cu: <http://counteruav.org/counterUav#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# SHACL 检查显式图数据；不启用 OWL 推理。
cu:Observation_timestampShape a sh:PropertyShape ;
 sh:path cu:timestamp ;
 sh:minCount 1 ;
 sh:maxCount 1 ;
 sh:message "观测必须有且仅有一个合法时间"@zh ;
 sh:datatype xsd:dateTime .

cu:Observation_lonShape a sh:PropertyShape ;
 sh:path cu:lon ;
 sh:minCount 1 ;
 sh:maxCount 1 ;
 sh:message "经度必须是 -180 到 180 的 double 数值"@zh ;
 sh:datatype xsd:double ;
 sh:minInclusive -180 ;
 sh:maxInclusive 180 .

cu:Observation_latShape a sh:PropertyShape ;
 sh:path cu:lat ;
 sh:minCount 1 ;
 sh:maxCount 1 ;
 sh:message "纬度必须是 -90 到 90 的 double 数值"@zh ;
 sh:datatype xsd:double ;
 sh:minInclusive -90 ;
 sh:maxInclusive 90 .

cu:Observation_ofTargetShape a sh:PropertyShape ;
 sh:path cu:ofTarget ;
 sh:minCount 1 ;
 sh:maxCount 1 ;
 sh:message "观测必须关联且仅关联一架无人机"@zh ;
 sh:nodeKind sh:IRI .

cu:ObservationShape a sh:NodeShape ; sh:targetClass cu:Observation ;
 sh:property cu:Observation_timestampShape, cu:Observation_lonShape, cu:Observation_latShape, cu:Observation_ofTargetShape .

cu:Assessment_ofTargetShape a sh:PropertyShape ;
 sh:path cu:ofTarget ;
 sh:minCount 1 ;
 sh:maxCount 1 ;
 sh:message "评估必须关联且仅关联一架无人机"@zh ;
 sh:nodeKind sh:IRI .

cu:Assessment_toPositionShape a sh:PropertyShape ;
 sh:path cu:toPosition ;
 sh:minCount 1 ;
 sh:maxCount 1 ;
 sh:message "评估必须关联且仅关联一个阵地"@zh ;
 sh:nodeKind sh:IRI .

cu:Assessment_basedOnObservationShape a sh:PropertyShape ;
 sh:path cu:basedOnObservation ;
 sh:minCount 1 ;
 sh:maxCount 1 ;
 sh:message "评估必须依据且仅依据一条观测"@zh ;
 sh:nodeKind sh:IRI .

cu:Assessment_usedRuleShape a sh:PropertyShape ;
 sh:path cu:usedRule ;
 sh:minCount 1 ;
 sh:maxCount 1 ;
 sh:message "评估必须采用且仅采用一版规则"@zh ;
 sh:nodeKind sh:IRI .

cu:Assessment_timestampShape a sh:PropertyShape ;
 sh:path cu:timestamp ;
 sh:minCount 1 ;
 sh:maxCount 1 ;
 sh:message "评估必须有且仅有一个合法时间"@zh ;
 sh:datatype xsd:dateTime .

cu:Assessment_distanceToPositionShape a sh:PropertyShape ;
 sh:path cu:distanceToPosition ;
 sh:minCount 1 ;
 sh:maxCount 1 ;
 sh:message "评估距离必须是非负 double 数值"@zh ;
 sh:datatype xsd:double ;
 sh:minInclusive 0 .

cu:AssessmentShape a sh:NodeShape ; sh:targetClass cu:Assessment ;
 sh:property cu:Assessment_ofTargetShape, cu:Assessment_toPositionShape, cu:Assessment_basedOnObservationShape, cu:Assessment_usedRuleShape, cu:Assessment_timestampShape, cu:Assessment_distanceToPositionShape .

cu:Position_nameShape a sh:PropertyShape ;
 sh:path cu:name ;
 sh:minCount 1 ;
 sh:maxCount 1 ;
 sh:message "阵地必须有且仅有一个名称"@zh ;
 sh:datatype xsd:string .

cu:Position_lonShape a sh:PropertyShape ;
 sh:path cu:lon ;
 sh:minCount 1 ;
 sh:maxCount 1 ;
 sh:message "阵地经度必须是 -180 到 180 的 double 数值"@zh ;
 sh:datatype xsd:double ;
 sh:minInclusive -180 ;
 sh:maxInclusive 180 .

cu:Position_latShape a sh:PropertyShape ;
 sh:path cu:lat ;
 sh:minCount 1 ;
 sh:maxCount 1 ;
 sh:message "阵地纬度必须是 -90 到 90 的 double 数值"@zh ;
 sh:datatype xsd:double ;
 sh:minInclusive -90 ;
 sh:maxInclusive 90 .

cu:PositionShape a sh:NodeShape ; sh:targetClass cu:Position ;
 sh:property cu:Position_nameShape, cu:Position_lonShape, cu:Position_latShape .

# V2.3 多源证据结构约束；不证明算法正确性。
@prefix cu: <http://counteruav.org/counterUav#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cu:AuthorizationRecordEvidenceShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "receivedAt 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:receivedAt ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "validUntil 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:validUntil ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "authoritySource 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:authoritySource ],
        [ sh:class cu:EvidenceRegion ;
            sh:maxCount 1 ;
            sh:message "authorizationRegion 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:authorizationRegion ],
        [ sh:datatype xsd:string ;
            sh:in ( "authorized"^^xsd:string "unauthorized"^^xsd:string "unknown"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "authorizationStatus 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:authorizationStatus ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "validFrom 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:validFrom ],
        [ sh:datatype xsd:string ;
            sh:in ( "simulated"^^xsd:string "unverified"^^xsd:string "operational"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "dataMode 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:dataMode ] ;
    sh:targetClass cu:AuthorizationRecord .

cu:EvidenceJudgementEvidenceShape a sh:NodeShape ;
    sh:or ( [ sh:property [ sh:maxCount 0 ;
                        sh:path cu:algorithmScore ] ] [ sh:property [ sh:datatype xsd:string ;
                        sh:maxCount 1 ;
                        sh:message "scoreMeaning 的数量、类型或允许值不符合证据约束"@zh ;
                        sh:minCount 1 ;
                        sh:path cu:scoreMeaning ] ] ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "methodVersion 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:methodVersion ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:message "algorithmScore 的数量、类型或允许值不符合证据约束"@zh ;
            sh:path cu:algorithmScore ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "receivedAt 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:receivedAt ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "scoreMeaning 的数量、类型或允许值不符合证据约束"@zh ;
            sh:path cu:scoreMeaning ],
        [ sh:class cu:SuspectedTarget ;
            sh:maxCount 1 ;
            sh:message "judgesHypothesis 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:judgesHypothesis ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "independenceNote 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:independenceNote ],
        [ sh:class cu:SensorObservation ;
            sh:path cu:inputObservation ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "methodName 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:methodName ],
        [ sh:datatype xsd:string ;
            sh:in ( "suspected"^^xsd:string "pending"^^xsd:string "insufficient"^^xsd:string "conflict"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "reportedJudgementStatus 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:reportedJudgementStatus ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "generatedAt 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:generatedAt ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "applicableConditions 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:applicableConditions ],
        [ sh:datatype xsd:string ;
            sh:in ( "association"^^xsd:string "identification"^^xsd:string "intrusion"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "judgementLayer 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:judgementLayer ],
        [ sh:datatype xsd:string ;
            sh:in ( "simulated"^^xsd:string "unverified"^^xsd:string "operational"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "dataMode 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:dataMode ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "uncertaintyNote 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:uncertaintyNote ] ;
    sh:targetClass cu:EvidenceJudgement .

cu:EvidenceRegionEvidenceShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "simulated"^^xsd:string "unverified"^^xsd:string "operational"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "dataMode 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:dataMode ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "receivedAt 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:receivedAt ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "geometryRef 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:geometryRef ] ;
    sh:targetClass cu:EvidenceRegion .

cu:SensorDeviceEvidenceShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "simulated"^^xsd:string "unverified"^^xsd:string "operational"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "dataMode 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:dataMode ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "reportedAt 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:reportedAt ],
        [ sh:datatype xsd:string ;
            sh:in ( "radar"^^xsd:string "radio"^^xsd:string "camera"^^xsd:string "infrared"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "sensorKind 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:sensorKind ],
        [ sh:datatype xsd:string ;
            sh:in ( "normal"^^xsd:string "fault"^^xsd:string "unknown"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "reportedDeviceStatus 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:reportedDeviceStatus ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "receivedAt 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:receivedAt ] ;
    sh:targetClass cu:SensorDevice .

cu:SensorObservationEvidenceShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "simulated"^^xsd:string "unverified"^^xsd:string "operational"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "dataMode 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:dataMode ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "receivedAt 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:receivedAt ],
        [ sh:datatype xsd:string ;
            sh:in ( "usable"^^xsd:string "invalid"^^xsd:string "unknown"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "inputQuality 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:inputQuality ],
        [ sh:datatype xsd:string ;
            sh:in ( "WGS84"^^xsd:string "unknown"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "coordinateSystem 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:coordinateSystem ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:maxInclusive 180 ;
            sh:message "lon 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minInclusive -180 ;
            sh:path cu:lon ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "rawEvidenceRef 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:rawEvidenceRef ],
        [ sh:datatype xsd:string ;
            sh:in ( "detected"^^xsd:string "not_detected"^^xsd:string "unknown"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "detectionOutcome 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:detectionOutcome ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "observedAt 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:observedAt ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:maxInclusive 90 ;
            sh:message "lat 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minInclusive -90 ;
            sh:path cu:lat ],
        [ sh:class cu:SensorDevice ;
            sh:maxCount 1 ;
            sh:message "fromDevice 的数量、类型或允许值不符合证据约束"@zh ;
            sh:minCount 1 ;
            sh:path cu:fromDevice ] ;
    sh:targetClass cu:SensorObservation .


# V2.4：登记设备与最新状态；不校验探测/干扰因果。
cu:DeviceRegistryShape a sh:NodeShape ; sh:targetSubjectsOf cu:deviceKind ;
 sh:property [ sh:path cu:deviceKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("uav"^^xsd:string "radar"^^xsd:string "jammer"^^xsd:string) ; sh:message "设备类型必须是无人机、雷达或干扰器"@zh ] ;
 sh:property [ sh:path cu:deployedAt ; sh:maxCount 1 ; sh:class cu:Position ; sh:message "部署关系必须指向已登记的阵地"@zh ] ;
 sh:property [ sh:path cu:configurationSource ; sh:minCount 1 ; sh:datatype xsd:string ; sh:message "配置来源不能为空"@zh ] .
cu:DeviceStateShape a sh:NodeShape ; sh:targetClass cu:DeviceState ;
 sh:property [ sh:path cu:stateOfDevice ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:message "状态必须指向一个设备"@zh ] ;
 sh:property [ sh:path cu:sourceTick ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:message "帧号必须是非负整数"@zh ] ;
 sh:property [ sh:path cu:publishedAt ; sh:minCount 1 ; sh:datatype xsd:dateTime ; sh:message "保留UTC发布时间"@zh ] ;
 sh:property [ sh:path cu:simulationTimeSeconds ; sh:minCount 1 ; sh:datatype xsd:double ; sh:minInclusive 0 ; sh:message "仿真时间不能代替UTC时间"@zh ] ;
 sh:property [ sh:path cu:receivedAt ; sh:minCount 1 ; sh:datatype xsd:dateTime ; sh:message "保留服务端接收时间"@zh ] ;
 sh:property [ sh:path cu:rcLinked ; sh:maxCount 1 ; sh:datatype xsd:boolean ; sh:message "遥控链路字段必须为布尔值，缺失不补false"@zh ] ;
 sh:property [ sh:path cu:emitterEmitting ; sh:maxCount 1 ; sh:datatype xsd:boolean ; sh:message "实际发射字段必须为布尔值"@zh ] .
