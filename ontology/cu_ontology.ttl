@prefix cu: <http://counteruav.org/counterUav#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cu: a owl:Ontology ; rdfs:label "无人机观测与评估本体"@zh ; owl:versionInfo "2.2.0" ;
 rdfs:comment "Python计算距离和等级；RDF关联目标、观测、阵地与规则。未启用自动推理。"@zh .

cu:BlueDevice a owl:Class ; rdfs:label "无人机目标"@zh ; rdfs:comment "持续存在的目标对象，不直接保存多个阵地的距离。"@zh .
cu:Position a owl:Class ; rdfs:label "阵地"@zh ; rdfs:comment "被关联评估的固定阵地。"@zh .
cu:DistanceLevel a owl:Class ; rdfs:label "距离关注等级"@zh ; rdfs:comment "仅根据距离分级，不代表综合威胁。"@zh .
cu:Observation a owl:Class ; rdfs:label "观测记录"@zh ; rdfs:comment "某来源在某时刻上报的位置和速度。"@zh .
cu:Assessment a owl:Class ; rdfs:label "评估记录"@zh ; rdfs:comment "针对一架无人机和一个阵地，依据一条观测和一版规则产生的评估。"@zh .
cu:DistanceRule a owl:Class ; rdfs:label "距离分级规则"@zh ; rdfs:comment "一版配置的不可变规则快照。"@zh .

# 数据属性
cu:name a owl:DatatypeProperty ; rdfs:label "名称"@zh ; rdfs:range xsd:string .
cu:lon a owl:DatatypeProperty ; rdfs:label "经度（WGS84）"@zh ; rdfs:range xsd:double .
cu:lat a owl:DatatypeProperty ; rdfs:label "纬度（WGS84）"@zh ; rdfs:range xsd:double .
cu:speed a owl:DatatypeProperty ; rdfs:label "速度（米/秒）"@zh ; rdfs:range xsd:double .
cu:timestamp a owl:DatatypeProperty ; rdfs:label "观测或评估时间"@zh ; rdfs:range xsd:dateTime .
cu:source a owl:DatatypeProperty ; rdfs:label "数据来源"@zh ; rdfs:range xsd:string .
cu:distanceToPosition a owl:DatatypeProperty ; rdfs:label "评估距离（米）"@zh ; rdfs:range xsd:double .
cu:positionId a owl:DatatypeProperty ; rdfs:label "评估时阵地编号"@zh ; rdfs:range xsd:string .
cu:positionName a owl:DatatypeProperty ; rdfs:label "评估时阵地名称"@zh ; rdfs:range xsd:string .
cu:positionLon a owl:DatatypeProperty ; rdfs:label "评估时阵地经度"@zh ; rdfs:range xsd:double .
cu:positionLat a owl:DatatypeProperty ; rdfs:label "评估时阵地纬度"@zh ; rdfs:range xsd:double .
cu:ruleVersion a owl:DatatypeProperty ; rdfs:label "配置和规则版本"@zh ; rdfs:range xsd:string .
cu:highThreshold a owl:DatatypeProperty ; rdfs:label "高关注阈值（米）"@zh ; rdfs:range xsd:double .
cu:mediumThreshold a owl:DatatypeProperty ; rdfs:label "中关注阈值（米）"@zh ; rdfs:range xsd:double .
cu:lowThreshold a owl:DatatypeProperty ; rdfs:label "低关注阈值（米）"@zh ; rdfs:range xsd:double .
cu:staleSeconds a owl:DatatypeProperty ; rdfs:label "数据有效时长（秒）"@zh ; rdfs:range xsd:double .
cu:configJson a owl:DatatypeProperty ; rdfs:label "运行配置JSON"@zh ; rdfs:range xsd:string .

# 对象属性
cu:latestObservation a owl:ObjectProperty ; rdfs:label "最新观测"@zh ; rdfs:domain cu:BlueDevice ; rdfs:range cu:Observation .
cu:latestAssessment a owl:ObjectProperty ; rdfs:label "当前评估"@zh ; rdfs:domain cu:BlueDevice ; rdfs:range cu:Assessment .
cu:ofTarget a owl:ObjectProperty ; rdfs:label "所属无人机"@zh ; rdfs:range cu:BlueDevice .
cu:toPosition a owl:ObjectProperty ; rdfs:label "评估针对的阵地"@zh ; rdfs:domain cu:Assessment ; rdfs:range cu:Position .
cu:basedOnObservation a owl:ObjectProperty ; rdfs:label "依据观测"@zh ; rdfs:domain cu:Assessment ; rdfs:range cu:Observation .
cu:usedRule a owl:ObjectProperty ; rdfs:label "采用规则"@zh ; rdfs:domain cu:Assessment ; rdfs:range cu:DistanceRule .
cu:hasDistanceLevel a owl:ObjectProperty ; rdfs:label "距离关注等级"@zh ; rdfs:domain cu:Assessment ; rdfs:range cu:DistanceLevel .

# 智能态势问答：排序由策略及Python约束，大模型只解释。
cu:AttentionRankingPolicy a owl:Class ; rdfs:label "关注排序策略"@zh ; rdfs:comment "声明排序字段、等级顺序与版本；不是让大模型自由排序。"@zh .
cu:SituationAnalysis a owl:Class ; rdfs:label "态势分析快照"@zh ; rdfs:comment "一次问题对应一个固定数据快照；实时变化不改写已返回的卡片。"@zh .
cu:RankedCandidate a owl:Class ; rdfs:label "排序候选记录"@zh ; rdfs:comment "某次分析中一架无人机的确定性排序结果与依据。"@zh .
cu:sortKeys a owl:ObjectProperty ; rdfs:label "排序字段列表"@zh ; rdfs:domain cu:AttentionRankingPolicy .
cu:levelOrder a owl:ObjectProperty ; rdfs:label "等级优先顺序"@zh ; rdfs:domain cu:AttentionRankingPolicy .
cu:hasCandidate a owl:ObjectProperty ; rdfs:label "包含排序候选"@zh ; rdfs:domain cu:SituationAnalysis ; rdfs:range cu:RankedCandidate .
cu:usedRankingPolicy a owl:ObjectProperty ; rdfs:label "采用排序策略"@zh ; rdfs:domain cu:SituationAnalysis ; rdfs:range cu:AttentionRankingPolicy .
cu:analysisPosition a owl:ObjectProperty ; rdfs:label "分析针对的阵地"@zh ; rdfs:domain cu:SituationAnalysis ; rdfs:range cu:Position .
cu:basedOnAssessment a owl:ObjectProperty ; rdfs:label "依据距离评估"@zh ; rdfs:domain cu:RankedCandidate ; rdfs:range cu:Assessment .
cu:previousObservation a owl:ObjectProperty ; rdfs:label "趋势计算的前次观测"@zh ; rdfs:domain cu:RankedCandidate ; rdfs:range cu:Observation .
cu:rank a owl:DatatypeProperty ; rdfs:label "本次名次"@zh ; rdfs:domain cu:RankedCandidate ; rdfs:range xsd:integer .
cu:levelPriority a owl:DatatypeProperty ; rdfs:label "距离等级优先值"@zh ; rdfs:domain cu:RankedCandidate ; rdfs:range xsd:integer .
cu:closingSpeed a owl:DatatypeProperty ; rdfs:label "两次观测的平均径向接近速度（米/秒）"@zh ; rdfs:domain cu:RankedCandidate ; rdfs:range xsd:double .
cu:etaToHighAttention a owl:DatatypeProperty ; rdfs:label "预计进入高关注距离圈时间（秒）"@zh ; rdfs:domain cu:RankedCandidate ; rdfs:range xsd:double .
cu:targetIdentifier a owl:DatatypeProperty ; rdfs:label "排序用目标编号"@zh ; rdfs:range xsd:string .
cu:missingEta a owl:DatatypeProperty ; rdfs:label "未知预计时间的排序位置"@zh ; rdfs:domain cu:AttentionRankingPolicy ; rdfs:range xsd:string .
cu:maxTrendGapSeconds a owl:DatatypeProperty ; rdfs:label "趋势观测最大间隔（秒）"@zh ; rdfs:range xsd:integer .
